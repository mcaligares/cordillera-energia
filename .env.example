# ---------------------------------------------------------------------------
# PostHog
# Copiar a .env.local y completar. Sin estas variables el sitio funciona
# igual: la analítica queda en no-op (no se carga posthog-js, no hay red).
# ---------------------------------------------------------------------------

# Project API key del proyecto de PostHog. Empieza con "phc_".
# Es pública por diseño: viaja al navegador. Se usa para capturar eventos
# desde el sitio y también para el seed de la demo.
NEXT_PUBLIC_POSTHOG_KEY=

# A dónde manda los eventos el navegador.
#   Desarrollo : https://us.i.posthog.com  (o eu.i.posthog.com según la región)
#   Producción : /ingest   ← recomendado. Usa el proxy inverso del propio
#                dominio, así los bloqueadores no filtran los eventos.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Región, solo para resolver el destino del proxy inverso en build: us | eu
POSTHOG_REGION=us

# Host de la app de PostHog, para los enlaces que genera el SDK.
# Solo hace falta si usás /ingest y el proyecto está en EU.
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# ---------------------------------------------------------------------------
# Solo para scripts/seed-posthog.mjs (nunca llegan al navegador)
# ---------------------------------------------------------------------------

# Host absoluto de ingesta para el script. Solo hace falta si
# NEXT_PUBLIC_POSTHOG_HOST es "/ingest": Node no puede POSTear a una ruta
# relativa. Si se omite, el script lo deduce de POSTHOG_REGION.
# POSTHOG_INGEST_HOST=https://us.i.posthog.com

# Personal API key (empieza con "phx_"). OPCIONAL.
# Solo hace falta si querés que el script cree el dashboard del reporte
# semanal por API. Para sembrar eventos NO se necesita.
# Scopes mínimos: insight:write, dashboard:write.
POSTHOG_PERSONAL_API_KEY=

# ID numérico del proyecto, visible en la URL de PostHog:
# https://us.posthog.com/project/<ID>/...  OPCIONAL, va junto con la personal key.
POSTHOG_PROJECT_ID=
